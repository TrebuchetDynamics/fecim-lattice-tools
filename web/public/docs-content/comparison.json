{"id":"comparison","path":"docs/modules/comparison/eli5.md","title":"Module 5: Comparison - ELI5","category":"Learning","sha256":"8a2f6cba0288acfe9f34154fe3947183326101f18a6a6dd3b3377921d2f90dd1","rights":"MIT","attribution":"FeCIM Lattice Tools contributors (repository-authored Markdown; publisher assets excluded)","bytes":1478,"terms":[],"headings":[{"text":"Module 5: Comparison - ELI5","level":1,"anchor":"module-5-comparison---eli5"},{"text":"Evidence Status (Demonstrated vs Modeled vs Aspirational)","level":2,"anchor":"evidence-status-demonstrated-vs-modeled-vs-aspirational"},{"text":"Learning Objectives","level":2,"anchor":"learning-objectives"},{"text":"Intuition","level":2,"anchor":"intuition"},{"text":"Key Analogies","level":2,"anchor":"key-analogies"},{"text":"What The Simulator Simplifies","level":2,"anchor":"what-the-simulator-simplifies"},{"text":"Next Steps","level":2,"anchor":"next-steps"}],"nodes":[{"kind":"heading","level":1,"anchor":"module-5-comparison---eli5","children":[{"kind":"text","text":"Module 5: Comparison - ELI5"}]},{"kind":"heading","level":2,"anchor":"evidence-status-demonstrated-vs-modeled-vs-aspirational","children":[{"kind":"text","text":"Evidence Status (Demonstrated vs Modeled vs Aspirational)"}]},{"kind":"list","children":[{"kind":"item","children":[{"kind":"paragraph","children":[{"kind":"strong","children":[{"kind":"text","text":"Demonstrated:"}]},{"kind":"text","text":" Repository structure, navigation behavior, and code paths referenced in this page are implemented in this repo and verifiable from source/tests."}]}]},{"kind":"item","children":[{"kind":"paragraph","children":[{"kind":"strong","children":[{"kind":"text","text":"Modeled:"}]},{"kind":"text","text":" Equations, defaults, and performance/quality estimates are simulator or documentation models unless explicitly tied to cited measured data."}]}]},{"kind":"item","children":[{"kind":"paragraph","children":[{"kind":"strong","children":[{"kind":"text","text":"Aspirational