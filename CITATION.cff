    given-names: Juan
    affiliation: Trebuchet Dynamics
repository-code: https://github.com/TrebuchetDynamics/fecim-lattice-tools
url: https://github.com/TrebuchetDynamics/fecim-lattice-tools
license: MIT
keywords:
  - ferroelectric compute-in-memory
  - simulation
  - reproducibility
  - pre-silicon design
